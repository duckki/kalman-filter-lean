import Kalman
import Lean.Util.CollectAxioms

/-! Audit every theorem in the project proof namespace, including private helpers.
Contract definitions are propositions, and are intentionally not counted as proofs. -/

run_cmd do
  let env ← Lean.getEnv
  let allowed := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut count : Nat := 0
  for (name, info) in env.constants.toList do
    let userName := (Lean.privateToUserName? name).getD name
    if (`Kalman).isPrefixOf userName then
      match info with
      | .axiomInfo _ => throwError "Project axiom: {name}"
      | .thmInfo _ =>
        for axiomName in ← Lean.collectAxioms name do
          unless allowed.contains axiomName do
            throwError "Unexpected axiom {axiomName} in {name}"
        if (`Kalman.Proofs).isPrefixOf userName then
          count := count + 1
      | _ => pure ()
  for required in #[``Kalman.Proofs.RealRecursion.stepPositiveDefinite,
